<?xml version="1.0" encoding="utf-8"?>
<!--
  There is deliberately no <uses-permission android:name="android.permission.INTERNET" />
  in this file, and there must never be one. SPEC.md 1 and 5 make "resolves no
  reference" a property of the format rather than a habit of the code: every image
  and every sound is baked into the package, so a viewer that cannot reach the
  network is a viewer that cannot silently start depending on one.

  This is also what makes SPEC.md 5.2 enforceable. A non-redistributable package
  must never have its bytes leave the device, and the cheapest way to guarantee
  that is an app with no way to send them.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vorlaut"
        tools:targetApi="33">

        <!--
          Turning the tablet must not restart the app. Without this Android
          destroys and recreates the activity on every rotation, and the board
          comes back on its start page with the sentence bar empty: `route` and
          `opened` in MainActivity are composition state, so a recreation sends
          the front-door effect round again and reopens the package from the
          top. A child mid-sentence whose tablet gets picked up loses the
          sentence.

          Handling the change ourselves is honest rather than a dodge, because
          there is nothing left for Android to do about it: AlwaysLandscape
          draws the board landscape whatever shape the window is, and no
          resource here is qualified by orientation. Compose simply remeasures.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Opening a .obz from a file manager, a download, or a messaging app.

              Both the media type SPEC.md 2 gives the format and the one providers
              actually report for an unregistered extension are matched, plus a
              path pattern for the cases where a provider offers no type at all.
              An over-broad filter is the right trade here: a file that turns out
              not to be a board package is refused by the importer with a reason
              the person can act on, whereas a filter too narrow to see the file
              leaves them with no way in at all.
            -->
            <intent-filter android:label="@string/import_board_package">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
            <intent-filter android:label="@string/import_board_package">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.obz" />
                <data android:pathPattern=".*\\..*\\.obz" />
            </intent-filter>

            <!-- Sharing a package to the app from elsewhere. -->
            <intent-filter android:label="@string/import_board_package">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

    </application>

</manifest>
