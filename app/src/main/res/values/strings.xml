<?xml version="1.0" encoding="utf-8"?>
<!--
  German is the default locale, not English.

  Its siblings are bilingual behind a picker and this app should end up there
  too, but the base language is the one its users speak: these are German
  boards, built by German-speaking families, on a device handed to a German-
  speaking child. bildhaft made the same call for the same kind of reason.
  values-en/ carries the English.
-->
<resources>
    <!-- The product name, and the same word in every language. -->
    <string name="app_name" translatable="false">Vorlaut</string>
    <string name="import_board_package">Sammlung öffnen</string>

    <string name="add_collection">Sammlung hinzufügen</string>
    <string name="settings">Einstellungen</string>
    <string name="back">Zurück</string>

    <string name="empty_headline">Noch keine Sammlung auf diesem Gerät.</string>
    <string name="empty_body">Eine Sammlung kommt als .obz-Datei aus dem Editor. Öffne sie aus den Dateien, teile sie mit dieser App, oder hol sie unten herein.</string>
    <string name="empty_footnote">Ohne Sammlung hat dieses Gerät nichts zu sagen.</string>

    <string name="not_redistributable">nicht weitergeben</string>
    <!--
      Plurals rather than one format string: "1 Tafeln" is simply wrong, and a
      viewer whose first Sammlung has one board would have shown it on the very
      first screen anybody sees. Two quantities cannot share one plural, so the
      two halves are separate and joined by the separator below.
    -->
    <plurals name="boards">
        <item quantity="one">%d Tafel</item>
        <item quantity="other">%d Tafeln</item>
    </plurals>
    <plurals name="buttons">
        <item quantity="one">%d Taste</item>
        <item quantity="other">%d Tasten</item>
    </plurals>
    <plurals name="warnings_count">
        <item quantity="one">%d Warnung</item>
        <item quantity="other">%d Warnungen</item>
    </plurals>
    <string name="dot_separator" translatable="false">" · "</string>
    <string name="added">„%1$s“ hinzugefügt.</string>
    <string name="replaced">„%1$s“ ersetzt.</string>
    <string name="not_newer">„%1$s“ ist nicht neuer als die gespeicherte Fassung und wurde nicht übernommen.</string>
    <string name="refused">%1$s: %2$s</string>
    <string name="nothing_missing_body">Jede Taste hat, was sie versprochen hat.</string>
    <string name="warnings_intro">Diese Sammlung funktioniert. Ändern kann das nur, wer sie gebaut hat — die Reihenfolge unten ist die, in der es auf der Tafel steht.</string>
    <string name="no_warnings">Nichts fehlt in dieser Sammlung.</string>

