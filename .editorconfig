root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
# Composables are PascalCase by convention and the Compose tooling relies on it.
ktlint_function_naming_ignore_when_annotated_with = Composable
