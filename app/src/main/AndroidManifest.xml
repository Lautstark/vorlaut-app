<?xml version="1.0" encoding="utf-8"?>
<!--
  There is deliberately no <uses-permission android:name="android.permission.INTERNET" />
  in this file, and there must never be one. SPEC.md 1 and 5 make "resolves no
  reference" a property of the format rather than a habit of the code: every image
  and every sound is baked into the package, so a viewer that cannot reach the
  network is a viewer that cannot silently start depending on one.

  This is also what makes SPEC.md 5.2 enforceable. A non-redistributable package
  must never have its bytes leave the device, and the cheapest way to guarantee
  that is an app with no way to send them.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:drawable/ic_menu_agenda"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vorlaut"
        tools:targetApi="33">

        <!--
          A board is a landscape thing. Its rows and columns come from the
          package and the cells divide what is there: turned on end, a 3x5 board
          becomes five tall slots with the symbol squeezed into a strip, which is
          what a Galaxy Tab does by default because its natural orientation is
          portrait.

          userLandscape rather than landscape, so turning the tablet end for end
          turns the picture with it. A tablet lying on a table gets picked up
          from whichever side somebody is standing on, and a board upside down
          is worse than a board that rotated.

          Android 16 ignores this on large screens unless an app says otherwise,
          which is what the property below is: the compatibility override that
          hands orientation back to the app. Both are needed, and neither is
          worth having without the other.

          Lint calls the pair discouraged for exactly that reason, and it is
          right about the general case. It is suppressed rather than obeyed
          because the pair was measured on a tablet held in portrait: the board
          stayed landscape and was letterboxed, which is the outcome wanted.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="userLandscape"
            tools:ignore="DiscouragedApi">
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_ORIENTATION_OVERRIDE"
                android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Opening a .obz from a file manager, a download, or a messaging app.

              Both the media type SPEC.md 2 gives the format and the one providers
              actually report for an unregistered extension are matched, plus a
              path pattern for the cases where a provider offers no type at all.
              An over-broad filter is the right trade here: a file that turns out
              not to be a board package is refused by the importer with a reason
              the person can act on, whereas a filter too narrow to see the file
              leaves them with no way in at all.
            -->
            <intent-filter android:label="@string/import_board_package">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
            <intent-filter android:label="@string/import_board_package">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.obz" />
                <data android:pathPattern=".*\\..*\\.obz" />
            </intent-filter>

            <!-- Sharing a package to the app from elsewhere. -->
            <intent-filter android:label="@string/import_board_package">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

    </application>

</manifest>
